  {
   "name": "API-001 Création d'un compte",
   "item": [
    {
     "name": "POST /accounts",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/accounts",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"TEST API 001\",\n  \"siret\": \"{{siret}}\",\n  \"street\": \"1 rue de la Paix\",\n  \"city\": \"Paris\",\n  \"postalCode\": \"75002\",\n  \"segment\": \"PME\"\n}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set(\"siret\", String(Date.now()).padStart(14, \"1\").slice(-14));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Code HTTP 201\", () => pm.response.to.have.status(201));",
         "const b = pm.response.json();",
         "pm.test(\"Identifiant au format attendu\", () => pm.expect(b.id).to.match(/^001[A-Za-z0-9]{15}$/));",
         "pm.test(\"Valeurs identiques à la requête\", () => { pm.expect(b.name).to.eql(\"TEST API 001\"); pm.expect(b.siret).to.eql(pm.collectionVariables.get(\"siret\")); pm.expect(b.segment).to.eql(\"PME\"); });",
         "pm.collectionVariables.set(\"accountId\", b.id);"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "API-002 Consultation",
   "item": [
    {
     "name": "GET /accounts/{id}",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": "{{baseUrl}}/accounts/{{accountId}}"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
         "const schema = { type: \"object\", required: [\"id\", \"name\", \"siret\", \"city\", \"postalCode\", \"status\"],",
         "  properties: { id: { type: \"string\" }, name: { type: \"string\" }, siret: { type: [\"string\", \"null\"] }, status: { type: \"string\" } } };",
         "pm.test(\"Schéma conforme au contrat\", () => pm.response.to.have.jsonSchema(schema));",
         "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "API-003 Mise à jour partielle",
   "item": [
    {
     "name": "PATCH /accounts/{id}",
     "request": {
      "method": "PATCH",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/accounts/{{accountId}}",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"city\": \"Lyon\",\n  \"postalCode\": \"69003\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
         "const b = pm.response.json();",
         "pm.test(\"Adresse modifiée\", () => { pm.expect(b.city).to.eql(\"Lyon\"); pm.expect(b.postalCode).to.eql(\"69003\"); });",
         "pm.test(\"Autres champs inchangés\", () => { pm.expect(b.name).to.eql(\"TEST API 001\"); pm.expect(b.siret).to.eql(pm.collectionVariables.get(\"siret\")); pm.expect(b.segment).to.eql(\"PME\"); });"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "API-004 Champ obligatoire absent",
   "item": [
    {
     "name": "POST /accounts sans name",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
