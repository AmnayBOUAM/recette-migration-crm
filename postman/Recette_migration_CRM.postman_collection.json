   "name": "0 - Authentification",
   "item": [
    {
     "name": "Jeton OAuth (client-rw)",
     "request": {
      "method": "POST",
      "header": [],
      "url": "{{baseUrl}}/oauth/token",
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "grant_type",
         "value": "client_credentials"
        },
        {
         "key": "client_id",
         "value": "client-rw"
        },
        {
         "key": "client_secret",
         "value": "secret-rw"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
        ]
       }
      }
     ]
    },
