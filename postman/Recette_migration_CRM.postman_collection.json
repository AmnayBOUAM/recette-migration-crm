     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Code HTTP 400\", () => pm.response.to.have.status(400));",
         "pm.test(\"Corps d'erreur normalisé\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"code\"); pm.expect(b).to.have.property(\"message\"); });",
         "pm.test(\"Le champ name est désigné\", () => pm.expect(pm.response.json().field).to.eql(\"name\"));"
        ]
       }
      }
     ]
    },
